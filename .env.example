# ==============================================================================
# Sage AI (Lunar Engine) - Environment Configuration
# Copy this file to '.env' and fill in your preferred API keys.
# All keys can also be configured dynamically from within the Sage AI Settings UI!
# ==============================================================================

# --- Cloud LLM Provider API Keys (Optional - 100% Free Tiers Available) ---
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
COHERE_API_KEY=
HUGGINGFACE_API_KEY=

# --- Search & Developer Integrations ---
TAVILY_API_KEY=
GITHUB_TOKEN=

# --- Cloudflare Workers AI (Optional) ---
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# --- Local LLM & Image Generation ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
IMAGE_FREE_CREDITS=25

# --- Custom Paths (Optional - defaults to relative project directories) ---
# SAGE_DATA_DIR=./data
# SAGE_WORKSPACE_ROOT=./workspace
# ARTIFACTS_DIR=./artifacts

# --- User Profile Defaults (Optional - defaults to computer username) ---
# USER_DISPLAY_NAME=Explorer
# USER_EMAIL=user@local
